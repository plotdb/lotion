// 舞台內的元素: 由 js 建立, 位置全由 seek(t) 決定
.demo
  font-family: Geist, "Noto Sans TC", sans-serif
  .d-a
    position: absolute
    left: 0
    top: 0
  .d-caption
    width: 1920px
    text-align: center
    font-size: 44px
    font-weight: 600
  .d-label
    font-size: 30px
    color: #8A877F
    white-space: nowrap
  .d-dot
    width: 56px
    height: 56px
    margin: -28px 0 0 -28px
    border-radius: 50%
    background: #18181A
  .d-line
    width: 900px
    height: 2px
    margin-top: -1px
    background: #D9D6CF
  .d-tabs
    width: 880px
    height: 96px
    border-radius: 48px
    background: #FBFAF7
    box-shadow: 0 10px 30px -12px rgba(0,0,0,.18)
  .d-ind
    height: 76px
    border-radius: 38px
    background: #18181A
  .d-tab
    width: 220px
    text-align: center
    font-size: 32px
    font-weight: 600
    line-height: 96px
  .d-type
    width: 1920px
    text-align: center
    font-size: 64px
    font-weight: 700
