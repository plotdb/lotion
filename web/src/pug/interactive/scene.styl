.ix-sky
  position: absolute
  inset: 0
.ix-mtn, .ix-cloud, .ix-btn, .ix-temp, .ix-tip, .ix-ctl
  position: absolute
  left: 0
  top: 0
.ix-mtn
  width: 0
  height: 0
  border-style: solid
  border-color: transparent transparent #4a5a4f transparent
.ix-cloud
  width: 260px
  height: 120px
  border-radius: 60px
  background: #fff
  box-shadow: 0 8px 30px rgba(0,0,0,.12)
.ix-btn
  padding: 18px 36px
  border-radius: 40px
  background: #18181a
  color: #fff
  font: 600 36px "Noto Sans TC", sans-serif
.ix-temp
  font: 700 96px Geist, "Noto Sans TC", sans-serif
  color: #c0392b
.ix-tip
  padding: 24px 32px
  background: rgba(255,255,255,.92)
  border-radius: 16px
  font: 500 34px "Noto Sans TC", sans-serif
  color: #333
  width: 560px
.ix-ctl
  display: flex
  gap: 20px
  align-items: center
  font: 500 32px "Noto Sans TC", sans-serif
  input
    width: 300px
    height: 40px
.ix-ctl .ix-btn
  position: static
  font-size: 30px
  padding: 12px 28px
.ix-hint
  position: absolute
  left: 0
  top: 0
  font: 500 40px "Noto Sans TC", sans-serif
  color: #18181a
