#!/usr/bin/env bash
# 失敗時中止, 避免留下看似成功的半成品
set -euo pipefail
bin=./node_modules/.bin
rm -rf dist
mkdir -p dist
echo "build src/index.ls -> dist/index.js ..."
$bin/lsc -cp --no-header src/index.ls > dist/index.js
$bin/uglifyjs dist/index.js -m -c > dist/index.min.js
echo "build src/vector.ls -> dist/vector.js ..."
$bin/lsc -cp --no-header src/vector.ls > dist/vector.js
$bin/uglifyjs dist/vector.js -m -c > dist/vector.min.js
echo "build src/index.styl -> dist/index.css ..."
$bin/stylus -p src/index.styl > dist/index.css
$bin/stylus -p -c src/index.styl > dist/index.min.css
echo "build src/cli.ls -> dist/cli.js ..."
echo "#!/usr/bin/env node" > dist/cli.js
$bin/lsc -cbp --no-header src/cli.ls >> dist/cli.js
chmod +x dist/cli.js
echo "build block player -> dist/block/player.js ..."
mkdir -p dist/block
{
  for f in @plotdb/semver/index.min.js proxise/index.min.js @plotdb/csscope/index.min.js \
           @plotdb/rescope/index.min.js @plotdb/block/index.min.js; do
    echo "/* $f */"; cat "node_modules/$f"; echo ";"
  done
  echo "/* lotion block loader */"
  $bin/lsc -cbp --no-header src/block/loader.ls | $bin/uglifyjs -m -c
} > dist/block/player.js
echo "copy dist/ to web/ ..."
rm -rf web/static/assets/lib/lotion/dev/
mkdir -p web/static/assets/lib/lotion/dev/
cp -R dist/* web/static/assets/lib/lotion/dev/
# packed demo 直接以相對路徑使用 player.js
mkdir -p web/static/block
cp dist/block/player.js web/static/block/player.js
echo "done."
