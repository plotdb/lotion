// lotion 播放器樣式. 顏色以 css 變數提供, 可由外部覆寫.
.lotion
  --lotion-bg: #ECEAE5
  --lotion-paper: #FBFAF7
  --lotion-ink: #18181A
  --lotion-mute: #8A877F
  --lotion-line: #D9D6CF
  position: relative
  border: 1px solid var(--lotion-line)
  border-radius: 12px
  overflow: hidden
  outline: none
  .lotion-viewport
    position: relative
    width: 100%
    overflow: hidden
    background: var(--lotion-bg)
  .lotion-stage
    position: absolute
    left: 0
    top: 0
    transform-origin: 0 0
    background: var(--lotion-bg)
    overflow: hidden
    line-height: normal
  // 控制列: 進度條橫跨整個寬度, 壓在舞台與控制列的交界; 其餘按鈕排在下方一列
  .lotion-bar
    position: relative
    display: flex
    align-items: center
    gap: 14px
    height: 56px
    padding: 0 20px
    background: var(--lotion-paper)
    border-top: 1px solid var(--lotion-line)
    user-select: none
  .lotion-btn
    flex: none
    width: 40px
    height: 40px
    border-radius: 50%
    background: var(--lotion-ink)
    color: #fff
    display: flex
    align-items: center
    justify-content: center
    cursor: pointer
  // 播放 / 暫停圖示以 css 繪製
  .lotion-play:before
    content: ""
    margin-left: 3px
    border-style: solid
    border-width: 7px 0 7px 12px
    border-color: transparent transparent transparent #fff
  &.lotion-playing .lotion-play:before
    margin-left: 0
    width: 4px
    height: 14px
    border-width: 0 4px
    border-color: #fff
  .lotion-fs
    background: transparent
    color: var(--lotion-ink)
    border: 1px solid var(--lotion-line)
  // 字幕開關: 開啟時為實心
  .lotion-cc
    width: auto
    height: 28px
    padding: 0 8px
    border-radius: 6px
    font: 600 13px/1 sans-serif
    letter-spacing: .04em
    background: transparent
    color: var(--lotion-ink)
    border: 1px solid var(--lotion-line)
  &.lotion-captions-on .lotion-cc
    background: var(--lotion-ink)
    border-color: var(--lotion-ink)
    color: #fff
  // 字幕: 在舞台外, 字級依視窗寬度 ( 容器查詢單位 ), 位於底部安全區. 可以 css 變數覆寫
  .lotion-viewport
    container-type: inline-size
  .lotion-captions
    --lotion-caption-size: clamp(14px, 2.6cqw, 44px)
    position: absolute
    left: 10%
    right: 10%
    bottom: 6%
    display: none
    flex-direction: column
    align-items: center
    gap: .2em
    pointer-events: none
    text-align: center
    font-size: var(--lotion-caption-size)
    line-height: 1.35
  &.lotion-captions-on .lotion-captions
    display: flex
  .lotion-caption
    max-width: 100%
    padding: .12em .5em
    border-radius: .2em
    background: var(--lotion-caption-bg, rgba(0, 0, 0, .72))
    color: var(--lotion-caption-color, #fff)
    font-family: var(--lotion-caption-font, sans-serif)
    white-space: pre-wrap
  .lotion-time
    flex: none
    font: 14px/1 sans-serif
    color: var(--lotion-mute)
    font-variant-numeric: tabular-nums
    white-space: nowrap
  // 目前章節: 佔滿剩餘空間, 過長以刪節號截斷, 不影響進度條
  .lotion-chapter
    flex: 1
    min-width: 0
    font: 14px/1.2 sans-serif
    color: var(--lotion-ink)
    white-space: nowrap
    overflow: hidden
    text-overflow: ellipsis
  // 進度條: 平時是一條細線, 滑過或拖曳時變粗並顯示圓鈕
  .lotion-track
    position: absolute
    left: 0
    right: 0
    top: -9px
    height: 18px
    z-index: 1
    cursor: pointer
    touch-action: none
  .lotion-rail, .lotion-fill
    position: absolute
    left: 0
    top: 8px
    height: 3px
    transition: top .12s, height .12s
  .lotion-rail
    right: 0
    background: var(--lotion-line)
  .lotion-fill
    background: var(--lotion-ink)
  .lotion-knob
    position: absolute
    top: 3px
    width: 13px
    height: 13px
    margin-left: -6.5px
    border-radius: 50%
    background: var(--lotion-ink)
    transform: scale(0)
    transition: transform .12s
  .lotion-chapters
    position: absolute
    inset: 0
    pointer-events: none
  // 章節刻度: 以底色切開進度線
  .lotion-ch
    position: absolute
    top: 8px
    width: 2px
    height: 3px
    margin-left: -1px
    background: var(--lotion-paper)
    transition: top .12s, height .12s
  .lotion-track:hover, &.lotion-dragging .lotion-track
    .lotion-rail, .lotion-fill, .lotion-ch
      top: 7px
      height: 5px
    .lotion-knob
      transform: scale(1)
  // 觸控裝置沒有 hover: 圓鈕常駐
  @media (hover: none)
    .lotion-knob
      transform: scale(1)

// 載入中 ( start() 之前 ): 舞台內容可能尚未就緒, 先藏起來並顯示載入畫面; 控制列不作用
.lotion.lotion-loading
  .lotion-stage
    visibility: hidden
  .lotion-bar
    opacity: .5
    pointer-events: none
// 匯出中 ( encode() ): 舞台取消縮放, 由遮罩蓋住並顯示進度; 控制列不作用
.lotion.lotion-encoding
  .lotion-bar
    opacity: .5
    pointer-events: none
.lotion
  .lotion-loading-screen, .lotion-encoding-screen
    position: absolute
    inset: 0
    display: flex
    flex-direction: column
    gap: 12px
    align-items: center
    justify-content: center
    background: var(--lotion-bg)
    color: var(--lotion-mute)
  .lotion-progress
    font-size: 14px
    font-variant-numeric: tabular-nums
  // 播放器本身的 UI, 不在 seek(t) 控制的舞台內, 可以用 css 動畫
  .lotion-spinner
    width: 36px
    height: 36px
    border-radius: 50%
    border: 3px solid var(--lotion-line)
    border-top-color: var(--lotion-ink)
    animation: lotion-spin .8s linear infinite
@keyframes lotion-spin
  to
    transform: rotate(360deg)

// 全螢幕: 控制列固定在底部, 舞台填滿其餘空間
.lotion:fullscreen
  display: flex
  flex-direction: column
  border: 0
  border-radius: 0
  .lotion-viewport
    flex: 1
    aspect-ratio: auto !important
  .lotion-bar
    flex: none

// 可互動元素 ( lotion.hit ): 拖動不捲動頁面, 長按不跳出選單或選取文字
.lotion-hit
  cursor: pointer
  touch-action: none
  user-select: none
  -webkit-user-select: none
  -webkit-touch-callout: none
// 逐格輸出 ( ?render ): 舞台蓋滿視窗
.lotion.lotion-render
  position: fixed
  inset: 0
  z-index: 99999
  border: 0
  border-radius: 0
  .lotion-viewport
    width: 100vw
    height: 100vh
    aspect-ratio: auto !important
  .lotion-bar
    display: none
