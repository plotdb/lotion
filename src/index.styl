// lotion 播放器樣式. 顏色以 css 變數提供, 可由外部覆寫.
.lotion
  --lotion-bg: #ECEAE5
  --lotion-paper: #FBFAF7
  --lotion-ink: #18181A
  --lotion-mute: #8A877F
  --lotion-line: #D9D6CF
  position: relative
  border: 1px solid var(--lotion-line)
  border-radius: 12px
  overflow: hidden
  outline: none
  .lotion-viewport
    position: relative
    width: 100%
    overflow: hidden
    background: var(--lotion-bg)
  .lotion-stage
    position: absolute
    left: 0
    top: 0
    transform-origin: 0 0
    background: var(--lotion-bg)
    overflow: hidden
    line-height: normal
  .lotion-bar
    display: flex
    align-items: center
    gap: 18px
    height: 64px
    padding: 0 24px
    background: var(--lotion-paper)
    border-top: 1px solid var(--lotion-line)
    user-select: none
  .lotion-btn
    flex: none
    width: 40px
    height: 40px
    border-radius: 50%
    background: var(--lotion-ink)
    color: #fff
    display: flex
    align-items: center
    justify-content: center
    cursor: pointer
  // 播放 / 暫停圖示以 css 繪製
  .lotion-play:before
    content: ""
    margin-left: 3px
    border-style: solid
    border-width: 7px 0 7px 12px
    border-color: transparent transparent transparent #fff
  &.lotion-playing .lotion-play:before
    margin-left: 0
    width: 4px
    height: 14px
    border-width: 0 4px
    border-color: #fff
  .lotion-fs
    background: transparent
    color: var(--lotion-ink)
    border: 1px solid var(--lotion-line)
  // 字幕開關: 開啟時為實心
  .lotion-cc
    width: auto
    height: 28px
    padding: 0 8px
    border-radius: 6px
    font: 600 13px/1 sans-serif
    letter-spacing: .04em
    background: transparent
    color: var(--lotion-ink)
    border: 1px solid var(--lotion-line)
  &.lotion-captions-on .lotion-cc
    background: var(--lotion-ink)
    border-color: var(--lotion-ink)
    color: #fff
  // 字幕: 在舞台外, 字級依視窗寬度 ( 容器查詢單位 ), 位於底部安全區. 可以 css 變數覆寫
  .lotion-viewport
    container-type: inline-size
  .lotion-captions
    --lotion-caption-size: clamp(14px, 2.6cqw, 44px)
    position: absolute
    left: 10%
    right: 10%
    bottom: 6%
    display: none
    flex-direction: column
    align-items: center
    gap: .2em
    pointer-events: none
    text-align: center
    font-size: var(--lotion-caption-size)
    line-height: 1.35
  &.lotion-captions-on .lotion-captions
    display: flex
  .lotion-caption
    max-width: 100%
    padding: .12em .5em
    border-radius: .2em
    background: var(--lotion-caption-bg, rgba(0, 0, 0, .72))
    color: var(--lotion-caption-color, #fff)
    font-family: var(--lotion-caption-font, sans-serif)
    white-space: pre-wrap
  .lotion-time
    font: 15px/1 sans-serif
    color: var(--lotion-mute)
    font-variant-numeric: tabular-nums
    white-space: nowrap
  .lotion-track
    position: relative
    flex: 1
    height: 40px
    cursor: pointer
  .lotion-rail, .lotion-fill
    position: absolute
    left: 0
    top: 18px
    height: 4px
    border-radius: 2px
  .lotion-rail
    right: 0
    background: var(--lotion-line)
  .lotion-fill
    background: var(--lotion-ink)
  .lotion-knob
    position: absolute
    top: 13px
    width: 14px
    height: 14px
    margin-left: -7px
    border-radius: 50%
    background: var(--lotion-ink)
  .lotion-chapters
    position: absolute
    inset: 0
    pointer-events: none
  .lotion-ch
    position: absolute
    top: 14px
    width: 2px
    height: 12px
    margin-left: -1px
    border-radius: 1px
    background: var(--lotion-mute)
    opacity: .5

// 載入中 ( start() 之前 ): 舞台內容可能尚未就緒, 先藏起來並顯示載入畫面; 控制列不作用
.lotion.lotion-loading
  .lotion-stage
    visibility: hidden
  .lotion-bar
    opacity: .5
    pointer-events: none
// 匯出中 ( encode() ): 舞台取消縮放, 由遮罩蓋住並顯示進度; 控制列不作用
.lotion.lotion-encoding
  .lotion-bar
    opacity: .5
    pointer-events: none
.lotion
  .lotion-loading-screen, .lotion-encoding-screen
    position: absolute
    inset: 0
    display: flex
    flex-direction: column
    gap: 12px
    align-items: center
    justify-content: center
    background: var(--lotion-bg)
    color: var(--lotion-mute)
  .lotion-progress
    font-size: 14px
    font-variant-numeric: tabular-nums
  // 播放器本身的 UI, 不在 seek(t) 控制的舞台內, 可以用 css 動畫
  .lotion-spinner
    width: 36px
    height: 36px
    border-radius: 50%
    border: 3px solid var(--lotion-line)
    border-top-color: var(--lotion-ink)
    animation: lotion-spin .8s linear infinite
@keyframes lotion-spin
  to
    transform: rotate(360deg)

// 全螢幕: 控制列固定在底部, 舞台填滿其餘空間
.lotion:fullscreen
  display: flex
  flex-direction: column
  border: 0
  border-radius: 0
  .lotion-viewport
    flex: 1
    aspect-ratio: auto !important
  .lotion-bar
    flex: none

// 逐格輸出 ( ?render ): 舞台蓋滿視窗
.lotion.lotion-render
  position: fixed
  inset: 0
  z-index: 99999
  border: 0
  border-radius: 0
  .lotion-viewport
    width: 100vw
    height: 100vh
    aspect-ratio: auto !important
  .lotion-bar
    display: none
